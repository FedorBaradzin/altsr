# --- Инфраструктура ---
DATABASE_URL=postgresql+asyncpg://altsr:altsr@postgres:5432/altsr
REDIS_URL=redis://redis:6379/0

# --- Discovery ---
GECKO_NETWORKS=eth,base,bsc,solana
GECKO_BASE_URL=https://api.geckoterminal.com/api/v2
DEXSCREENER_BASE_URL=https://api.dexscreener.com
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
POLL_INTERVAL_SECONDS=30
DEDUP_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=3

# --- Safety / анти-скам (Фаза 1) ---
GOPLUS_BASE_URL=https://api.gopluslabs.io/api/v1
HONEYPOT_BASE_URL=https://api.honeypot.is/v2
SCREEN_BATCH_SIZE=20
SCREEN_INTERVAL_SECONDS=15

# --- Signal engine (Фаза 2) ---
SIGNAL_MIN_LIQUIDITY_USD=5000
SIGNAL_MIN_AGE_MINUTES=0
SIGNAL_MAX_AGE_MINUTES=1440
SIGNAL_MIN_HOLDERS=0
SIGNAL_REQUIRE_PASS=true
SIGNAL_MAX_RISK=30
SIGNAL_BATCH_SIZE=30
SIGNAL_INTERVAL_SECONDS=20

# --- Paper executor (Фаза 3) — ТОЛЬКО бумага ---
PAPER_START_BALANCE=100000
PAPER_POSITION_SIZE_USD=500
PAPER_MAX_POSITIONS=10
PAPER_DAILY_LOSS_LIMIT_USD=500
PAPER_HARD_STOP_PCT=0.25
PAPER_ARM_AFTER_PROFIT_PCT=0.20
PAPER_TRAILING_STOP_PCT=0.08
PAPER_TAKE_PROFIT_X=2.0
PAPER_TAKE_PROFIT_FRACTION=0.5
PAPER_STALL_MINUTES=15
PAPER_MAX_HOLD_MINUTES=240
PAPER_COST_PCT=0.01
PAPER_INTERVAL_SECONDS=10

# --- Live-исполнение (Фаза 5). РЕАЛЬНЫЕ ДЕНЬГИ — держать OFF до тестов и живого прогона. ---
LIVE_TRADING_ENABLED=false
LIVE_REQUIRE_CONFIRMATION=true
LIVE_DAILY_CAP_USD=0
LIVE_MAX_TRADE_USD=0
LIVE_WALLET_ADDRESS=
LIVE_PRIVATE_RPC=

# --- ИИ-слой новостей (Фаза 4). Без ключа — классификация по правилам (фолбэк). ---
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
NEWS_FEEDS=
NEWS_BATCH_SIZE=25
NEWS_INTERVAL_SECONDS=120

# --- Контент-движок: SEO-статьи из новостей (оригинальный разбор, не копия источника) ---
CONTENT_ENABLED=true
ARTICLES_PER_DAY=5
CONTENT_LANG=en
SITE_URL=https://altsr.app
# Фронтенд SEO (Next.js): NEXT_PUBLIC_SITE_URL=https://altsr.app

# --- Metricool: авто-постинг статей в соцсети (OFF по умолчанию) ---
METRICOOL_ENABLED=false
METRICOOL_BASE_URL=https://app.metricool.com/api
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
METRICOOL_NETWORKS=twitter,telegram
SOCIAL_POSTS_PER_RUN=3

# --- Telegram-уведомления + Telegram-вход (общий bot token) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# --- Аккаунты и сессии ---
JWT_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=720
# Админы: ваш кошелёк/google-sub/telegram-id ИЛИ email, через запятую (дают доступ к /admin)
ADMIN_IDENTIFIERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://altsr.app/api/auth/google/callback

# --- Биллинг: NOWPayments (крипто-оплата) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_URL=https://api.nowpayments.io/v1

# --- Необязательные ключи (Фаза 1+). Никогда не коммитить реальные значения. ---
BIRDEYE_API_KEY=
HELIUS_API_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Фронтенд (впекается в бандл при сборке; на проде — ваш домен) ---
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
NEXT_PUBLIC_SITE_URL=https://altsr.app
NEXT_PUBLIC_TELEGRAM_BOT=
