# ===== ALTSR prod .env (НЕсекретная часть, безопасно в git) =====
# Секреты (JWT_SECRET, ключи интеграций) сюда НЕ пишем — они задаются
# переменными окружения стека в Hostinger Docker Manager и переопределяют
# значения отсюда. См. docker-compose.deploy.yml -> environment.

# --- Инфраструктура (внутренняя docker-сеть) ---
DATABASE_URL=postgresql+asyncpg://altsr:altsr@postgres:5432/altsr
REDIS_URL=redis://redis:6379/0

# --- Домен ---
SITE_URL=https://altsr.space
CORS_ORIGINS=https://altsr.space
NEXT_PUBLIC_API_BASE=https://altsr.space
NEXT_PUBLIC_WS_BASE=wss://altsr.space
NEXT_PUBLIC_SITE_URL=https://altsr.space

# --- Discovery ---
GECKO_NETWORKS=eth,base,bsc,solana
POLL_INTERVAL_SECONDS=30

# --- Бумажная торговля ($100k, постоянная) ---
PAPER_START_BALANCE=100000
PAPER_POSITION_SIZE_USD=500

# --- Админ (не секрет): идентификатор для входа в /admin ---
ADMIN_IDENTIFIERS=bettydarby00056@gmail.com

# --- Google OAuth (не секрет: redirect) ---
GOOGLE_REDIRECT_URI=https://altsr.space/api/auth/google/callback

# --- ИИ: модель (ключ и включение — через env стека) ---
AI_MODEL=gpt-4o-mini

# --- Новости и контент (шаблонный режим из RSS) ---
NEWS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
ARTICLES_PER_DAY=5
CONTENT_LANG=en

# --- Реальная торговля: OFF до тестов ---
LIVE_TRADING_ENABLED=false
