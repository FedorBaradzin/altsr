# ===== ALTSR prod .env (НЕсекретная часть, безопасно в git) =====
# Секреты (JWT_SECRET, ключи интеграций) сюда НЕ пишем — они задаются
# переменными окружения стека в Hostinger Docker Manager и переопределяют
# значения отсюда. См. docker-compose.deploy.yml -> environment.

# --- Инфраструктура (внутренняя docker-сеть) ---
DATABASE_URL=postgresql+asyncpg://altsr:altsr@postgres:5432/altsr
REDIS_URL=redis://redis:6379/0

# --- Домен ---
SITE_URL=https://altsr.space
CORS_ORIGINS=https://altsr.space
NEXT_PUBLIC_API_BASE=https://altsr.space
NEXT_PUBLIC_WS_BASE=wss://altsr.space
NEXT_PUBLIC_SITE_URL=https://altsr.space

# --- Discovery ---
GECKO_NETWORKS=eth,base,bsc,solana
POLL_INTERVAL_SECONDS=30

# --- Отбор сигналов: сбалансировано — поток сделок + контроль риска ---
SIGNAL_MIN_LIQUIDITY_USD=8000      # отсекаем пыль, но пускаем больше кандидатов
SIGNAL_MAX_RISK=35                 # умеренный риск-скор (не только идеальные)
SIGNAL_MAX_AGE_MINUTES=1440        # окно момента шире (24ч)
SIGNAL_REQUIRE_PASS=true           # по-прежнему только PASS анти-скам
SIGNAL_MIN_CONFIDENCE=0.55         # входим в сигналы от средней уверенности

# --- Бумажная торговля ($100k, постоянная) — управление риском ---
PAPER_START_BALANCE=100000
PAPER_POSITION_SIZE_USD=300        # меньше размер ставки
PAPER_MAX_POSITIONS=10
PAPER_DAILY_LOSS_LIMIT_USD=300     # дневной стоп убытка
PAPER_HARD_STOP_PCT=0.15           # режем убытки быстрее
PAPER_ARM_AFTER_PROFIT_PCT=0.12    # раньше включаем трейлинг
PAPER_TRAILING_STOP_PCT=0.06       # плотный трейлинг — фиксируем прибыль
PAPER_TAKE_PROFIT_X=1.6            # раньше берём профит
PAPER_TAKE_PROFIT_FRACTION=0.6     # большую часть снимаем на цели
PAPER_STALL_MINUTES=10             # быстрее выходим из «мёртвых» сделок
PAPER_MAX_HOLD_MINUTES=180

# --- Админ (не секрет): идентификатор для входа в /admin ---
ADMIN_IDENTIFIERS=bettydarby00056@gmail.com

# --- Google OAuth (не секрет: redirect) ---
GOOGLE_REDIRECT_URI=https://altsr.space/api/auth/google/callback

# --- ИИ: модель (ключ и включение — через env стека) ---
AI_MODEL=gpt-4o-mini

# --- Новости и контент (шаблонный режим из RSS) ---
NEWS_FEEDS=https://cointelegraph.com/rss,https://www.coindesk.com/arc/outboundfeeds/rss/
ARTICLES_PER_DAY=5
CONTENT_LANG=en

# --- Реальная торговля: OFF до тестов ---
LIVE_TRADING_ENABLED=false
