# Caddy: авто-HTTPS (Let's Encrypt) + reverse proxy для altsr.space
# Требует: домен указывает A-записью на IP сервера, порты 80/443 открыты.

altsr.space {
	encode gzip

	# API и WebSocket → backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}

	# Юридические страницы (статика, запечена в образ Caddy) — нужны для публикации
	# Google OAuth consent (Privacy Policy / Terms обязательны).
	handle /privacy {
		root * /srv/legal
		rewrite * /privacy.html
		file_server
	}
	handle /terms {
		root * /srv/legal
		rewrite * /terms.html
		file_server
	}

	# Старый /radar (Next.js) → новый кабинет Neural Cosmos
	handle /radar {
		redir * /landing/cabinet/index.html
	}
	handle /radar/ {
		redir * /landing/cabinet/index.html
	}

	# Инвест-лендинг
	handle /investors {
		redir * /landing/investors/index.html
	}
	handle /investors/ {
		redir * /landing/investors/index.html
	}

	# всё остальное → фронтенд (Next.js)
	handle {
		reverse_proxy frontend:3000
	}
}
