# ===== ПРОД .env для altsr.space =====
# Скопируйте в корень проекта как .env и заполните СЕКРЕТЫ (пустые поля ниже).
#   cp deploy/.env.altsr.space .env  &&  nano .env

# --- Инфраструктура (менять не нужно) ---
DATABASE_URL=postgresql+asyncpg://altsr:altsr@postgres:5432/altsr
REDIS_URL=redis://redis:6379/0

# --- Домен / фронтенд (впекается в бандл при сборке) ---
SITE_URL=https://altsr.space
CORS_ORIGINS=https://altsr.space
NEXT_PUBLIC_API_BASE=https://altsr.space
NEXT_PUBLIC_WS_BASE=wss://altsr.space
NEXT_PUBLIC_SITE_URL=https://altsr.space

# --- Discovery (без ключа) ---
GECKO_NETWORKS=eth,base,bsc,solana
POLL_INTERVAL_SECONDS=30

# --- Безопасность / сигналы / бумага ($100k, постоянная торговля) ---
PAPER_START_BALANCE=100000
PAPER_POSITION_SIZE_USD=500

# --- Сессии и админ ---
JWT_SECRET=ЗАМЕНИТЬ_НА_ДЛИННУЮ_СЛУЧАЙНУЮ_СТРОКУ
# Ваш идентификатор для доступа в /admin (email из Google ИЛИ адрес кошелька ИЛИ telegram-id):
ADMIN_IDENTIFIERS=

# --- Google OAuth (создать в Google Cloud Console) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://altsr.space/api/auth/google/callback

# --- Telegram (вход + алерты): бот у @BotFather ---
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT=
TELEGRAM_CHAT_ID=

# --- NOWPayments (крипто-оплата) ---
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- ИИ (умный консультант + качественные статьи + классификация новостей) ---
AI_ENABLED=true
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Новости и контент ---
NEWS_FEEDS=
ARTICLES_PER_DAY=5
CONTENT_LANG=en

# --- Metricool (авто-постинг в соцсети) — по желанию ---
METRICOOL_ENABLED=false
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# --- Live-торговля реальными деньгами: ДЕРЖАТЬ OFF до тестов ---
LIVE_TRADING_ENABLED=false
